FROM node:24.22.1-alpine3.24

# This service uses Node built-ins only. Remove unused package-manager payloads.
RUN apk upgrade --no-cache \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
      /opt/yarn-* /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
      /usr/local/bin/yarn /usr/local/bin/yarnpkg

ENV NODE_ENV=production
ENV VERIFICATION_ENVIRONMENT=azure-test
ENV VERIFICATION_PUBLIC=1
ENV PORT=8081

WORKDIR /app

COPY verification/server.cjs verification/sessions.cjs verification/worker-pool.cjs verification/pool-worker.cjs verification/world.cjs verification/protocol.mjs verification/replay.cjs verification/chat.cjs verification/capacity-reporter.cjs ./verification/
COPY shared/ ./shared/
COPY data/track-objects.json ./data/track-objects.json
COPY campus.js vehicle.js replay-pose.js ./

USER node
EXPOSE 8081

CMD ["node", "verification/server.cjs"]
